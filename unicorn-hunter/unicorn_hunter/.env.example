# Unicorn Hunter Environment Variables
# ALL FREE TIERS - NO PAID SERVICES REQUIRED

# ============================================
# FREE API Keys (Optional - works without keys)
# ============================================

# Binance API (optional - for higher rate limits, not required)
# Get from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# GitHub API Token (optional - for private repos)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# CoinGecko API (optional - free tier: 50 calls/minute, NO credit card)
# Get from: https://www.coingecko.com/en/developers
# Works WITHOUT API key (limited rate)
COINGECKO_API_KEY=

# Dune Analytics API (optional - free tier: 1,000 requests/month, NO credit card)
# Get from: https://app.dune.com/apikey
DUNE_API_KEY=

# Covalent API (optional - free tier: 300,000 requests/month, NO credit card)
# Get from: https://www.covalenthq.com/
COVALENT_API_KEY=

# Ethplorer API (optional - FREE, no key required for basic usage)
# Get from: https://ethplorer.io/
ETHPLORER_API_KEY=freekey

# ============================================
# REQUIRED - Gemini API (Only Paid API)
# ============================================

# Gemini API Key (REQUIRED for AI analysis)
# This is the ONLY API you need to pay for
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Server Configuration
# ============================================

# Server host and port
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Node.js Integration
# ============================================

# Node.js backend URL for database operations
NODE_JS_URL=http://localhost:3000

# ============================================
# AI/LLM Configuration
# ============================================

# CrewAI API Key (optional - if using CrewAI cloud instead of local)
CREWAI_API_KEY=
